{
  "name": "hamly-pregnancy-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env EXPO_NO_TELEMETRY=1 npx expo start",
    "dev:web": "cross-env EXPO_NO_TELEMETRY=1 HOST=0.0.0.0 EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY npx expo start --web --port 5000",
    "build": "expo export --platform web --output-dir dist --dump-sourcemap",
    "build:web": "cross-env NODE_ENV=production EXPO_NO_SSR=1 EXPO_USE_STATIC=1 EXPO_USE_METRO_REQUIRE=1 EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY npx expo export --platform web --output-dir dist --clear && node scripts/cleanup-build.js && node scripts/setup-favicons.js",
    "cleanup": "node scripts/cleanup-build.js",
    "start": "cross-env EXPO_NO_TELEMETRY=1 npx expo start --web --port 5000 --offline",
    "serve:dist": "npx serve -s dist -l 5000",
    "reset:onboarding": "node scripts/reset-welcome.js",
    "lint": "npx expo lint",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^54.0.16",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.12",
    "expo-router": "^6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.12",
    "expo-video": "~3.0.11",
    "expo-web-browser": "~15.0.8",
    "fbjs": "^3.0.5",
    "invariant": "^2.2.4",
    "lucide-react-native": "^0.546.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-onboarding-swiper": "^1.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "cross-env": "^7.0.3",
    "serve": "^14.2.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
